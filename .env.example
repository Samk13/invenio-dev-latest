INVENIO_S3_ENDPOINT_URL='https://localhost:9000/'
INVENIO_S3_ACCESS_KEY_ID='CHANGE_ME'
INVENIO_S3_SECRET_ACCESS_KEY='CHANGE_ME'

# Trust the self-signed RustFS certificate in the Python backend without changing
# system trust or disabling TLS verification. Run the app from the repository root.
# Generate this certificate with make dev-certs; browser trust is handled separately.
AWS_CA_BUNDLE=./docker/certs/ca.pem