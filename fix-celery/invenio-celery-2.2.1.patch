+@worker_process_init.connect
+def initialize_worker(sender=None, **kwargs):
+    """Initialize Celery's task trace in spawned pool workers."""
+    if sys.platform != "darwin":
+        return
+    celery = current_app._get_current_object()
+    if not hasattr(celery, "flask_app"):
+        factory = celery.conf.get("CELERY_FLASK_APP_FACTORY")
+        if factory:
+            celery.flask_app = symbol_by_name(factory)()
+    if not trace._localized:
+        trace.setup_worker_optimizations(celery)
 
 
